# Variáveis de ambiente necessárias para rodar o projeto localmente.
# Copie este arquivo para ".env.local" e preencha com os valores do seu projeto Supabase.
# (Painel Supabase > Project Settings > API)

# URL do projeto Supabase (ex.: https://xxxxxxxx.supabase.co)
NEXT_PUBLIC_SUPABASE_URL=

# Chave pública (anon) do Supabase
NEXT_PUBLIC_SUPABASE_ANON_KEY=
